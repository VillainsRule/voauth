{
    "name": "voauth",
    "scripts": {
        "apidev": "cd api && bun --watch src/main.ts",
        "appdev": "cd app && bunx --bun vite build --watch",
        "build": "cd app && bunx --bun vite build",
        "pull": "git pull && bun install && bun run build && systemctl restart voauth && quik purge voauth.villainsrule.xyz",
        "cn": "mv @/components/ui/* ./app/src/components/ui/ && rm -rf ./@/"
    },
    "dependencies": {
        "@elysiajs/eden": "^1.4.9",
        "@simplewebauthn/browser": "^13.3.0",
        "@simplewebauthn/server": "^13.3.0",
        "@tailwindcss/vite": "^4.2.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "elysia": "^1.4.28",
        "lucide-react": "^1.11.0",
        "mime": "^4.1.0",
        "radix-ui": "^1.4.3",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "shadcn": "^4.5.0",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^4.2.4",
        "tw-animate-css": "^1.4.0",
        "vite": "^8.0.10",
        "wouter": "^3.9.0"
    },
    "devDependencies": {
        "@types/bun": "^1.3.13",
